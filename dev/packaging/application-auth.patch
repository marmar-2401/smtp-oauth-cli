diff --git a/src/application_token_test.cc b/src/application_token_test.cc
new file mode 100644
index 0000000..5c48a2c
--- /dev/null
+++ b/src/application_token_test.cc
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "application_token.h"
+#include "config.h"
+#include "http.h"
+#include "token_store.h"
+#include "log.h"
+#include "module.h"
+#include <cstdlib>
+#include <ctime>
+#include <sys/wait.h>
+#include <fcntl.h>
+#include <sasl/sasl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <cassert>
+#include <fstream>
+#include <string>
+using namespace sasl_xoauth2;
+namespace {
+int NoCallback(sasl_conn_t *, unsigned long, sasl_callback_ft *, void **) {
+  return SASL_FAIL;
+}
+int CanonUser(sasl_conn_t *, const char *, unsigned int, unsigned int,
+              sasl_out_params_t *) { return SASL_OK; }
+
+void TestSaslRejectionRenews(const std::string &path) {
+  sasl_utils_t utils = {};
+  utils.free = &free;
+  utils.malloc = &malloc;
+  utils.getcallback = &NoCallback;
+  int version = 0, count = 0;
+  sasl_client_plug_t *plugins = nullptr;
+  assert(sasl_client_plug_init(&utils, SASL_CLIENT_PLUG_VERSION, &version,
+                              &plugins, &count) == SASL_OK);
+  assert(count == 1);
+  const auto plug = plugins[0];
+  sasl_client_params_t params = {};
+  params.utils = &utils;
+  params.canon_user = &CanonUser;
+  const std::string mailbox = "relay@example.com";
+  for (const std::string status : {"400", "401"}) {
+    Json::Value cache;
+    cache["access_token"] = "rejected-token";
+    cache["expiry"] = Json::Int64(time(nullptr) + 3600);
+    { std::ofstream f(path); f << cache; }
+    int requests = 0;
+    SetHttpInterceptForTesting([&](HttpPostOptions o) {
+      ++requests;
+      assert(o.application_auth);
+      assert(o.data.find("grant_type=client_credentials&") == 0);
+      assert(o.data.find("refresh_token") == std::string::npos);
+      *o.response_code = 200;
+      *o.response = R"({"access_token":"renewed-token","token_type":"Bearer","expires_in":3600})";
+      return SASL_OK;
+    });
+    // Drive the same exported plugin entry points that Cyrus invokes. A fresh
+    // connection after SASL_TRYAGAIN must use the newly persisted token.
+    for (int connection = 0; connection < 2; ++connection) {
+      void *context = nullptr;
+      assert(plug.mech_new(nullptr, nullptr, &context) == SASL_OK);
+      auto *prompts = static_cast<sasl_interact_t *>(calloc(3, sizeof(sasl_interact_t)));
+      assert(prompts);
+      prompts[0].id = SASL_CB_AUTHNAME;
+      prompts[0].result = mailbox.data();
+      prompts[0].len = mailbox.size();
+      prompts[1].id = SASL_CB_PASS;
+      prompts[1].result = path.data();
+      prompts[1].len = path.size();
+      prompts[2].id = SASL_CB_LIST_END;
+      const char *output = nullptr;
+      unsigned int size = 0;
+      sasl_out_params_t out = {};
+      assert(plug.mech_step(context, &params, nullptr, 0, &prompts,
+                            &output, &size, &out) == SASL_OK);
+      assert(prompts == nullptr);
+      const std::string expected = "user=" + mailbox + "\1auth=Bearer " +
+          (connection == 0 ? "rejected-token" : "renewed-token") + "\1\1";
+      assert(std::string(output, size) == expected);
+      assert(requests == connection);
+      if (connection == 0) {
+        const std::string challenge = "{\"status\":\"" + status + "\"}";
+        assert(plug.mech_step(context, &params, challenge.data(), challenge.size(),
+                              nullptr, &output, &size, &out) == SASL_TRYAGAIN);
+        assert(requests == 1 && size == 0);
+      } else {
+        assert(plug.mech_step(context, &params, "", 0, nullptr,
+                              &output, &size, &out) == SASL_OK);
+        assert(size == 0 && requests == 1);
+      }
+      plug.mech_dispose(context, &utils);
+    }
+    std::ifstream f(path);
+    Json::Value persisted;
+    f >> persisted;
+    assert(persisted["access_token"].asString() == "renewed-token");
+    assert(!persisted.isMember("refresh_token"));
+  }
+  SetHttpInterceptForTesting({});
+}
+}
+int main() {
+  Json::Value config;
+  config["client_id"] = "id+&%";
+  config["client_secret"] = "secret+&%= /";
+  config["grant_type"] = "client_credentials";
+  config["token_endpoint"] = "https://login.microsoftonline.com/11111111-1111-1111-1111-111111111111/oauth2/v2.0/token";
+  assert(Config::InitForTesting(config) == SASL_OK);
+  char dir[] = "/tmp/app-auth-test.XXXXXX";
+  assert(mkdtemp(dir));
+  const std::string path = std::string(dir) + "/token.json";
+  { std::ofstream f(path); f << "{}"; }
+  chmod(path.c_str(), 0600);
+  int calls = 0;
+  std::string response = R"({"access_token":"test-token","token_type":"Bearer","expires_in":3600})";
+  SetHttpInterceptForTesting([&](HttpPostOptions o) {
+    ++calls;
+    assert(o.application_auth);
+    assert(o.data == "grant_type=client_credentials&client_id=id%2B%26%25&client_secret=secret%2B%26%25%3D%20%2F&scope=https%3A%2F%2Foutlook.office365.com%2F.default");
+    *o.response_code = 200; *o.response = response; return SASL_OK;
+  });
+  std::string token;
+  assert(ApplicationToken(path, true, false, &token) == SASL_OK && token == "test-token" && calls == 1);
+  assert(ApplicationToken(path, true, false, &token) == SASL_OK && calls == 1);
+  struct stat st;
+  assert(stat(path.c_str(), &st) == 0 && (st.st_mode & 0777) == 0600);
+  for (const auto &bad : {"{}", "invalid", R"({"access_token":"leak","token_type":"Bearer","expires_in":0})", R"({"access_token":"leak","token_type":"Bearer","expires_in":"3600"})", R"({"access_token":"bad\nvalue","token_type":"Bearer","expires_in":3600})"}) {
+    response = bad;
+    assert(ApplicationToken(path, true, true, &token) != SASL_OK);
+  }
+  // Failure must preserve the last usable cache.
+  assert(ApplicationToken(path, true, false, &token) == SASL_OK && token == "test-token");
+  response = R"({"access_token":"new-token","token_type":"Bearer","expires_in":3600})";
+  // Exercise the public TokenStore wiring without a refresh_token field.
+  auto log = Log::Create();
+  auto store = TokenStore::Create(log.get(), path);
+  assert(store && store->Refresh() == SASL_OK);
+  assert(store->GetAccessToken(&token) == SASL_OK && token == "new-token");
+  // Separate SASL processes serialize refresh and reread the shared cache.
+  { std::ofstream f(path); f << "{}"; }
+  const std::string counter = std::string(dir) + "/requests";
+  SetHttpInterceptForTesting([&](HttpPostOptions o) {
+    int fd = open(counter.c_str(), O_WRONLY | O_CREAT | O_APPEND, 0600);
+    assert(fd >= 0 && write(fd, "x", 1) == 1); close(fd);
+    usleep(50000);
+    *o.response_code = 200; *o.response = response; return SASL_OK;
+  });
+  for (int i = 0; i < 8; ++i) {
+    const pid_t pid = fork(); assert(pid >= 0);
+    if (pid == 0) _exit(ApplicationToken(path, true, false, &token) == SASL_OK ? 0 : 1);
+  }
+  for (int i = 0; i < 8; ++i) {
+    int status; assert(wait(&status) > 0 && WIFEXITED(status) && WEXITSTATUS(status) == 0);
+  }
+  assert(stat(counter.c_str(), &st) == 0 && st.st_size == 1);
+  unlink(counter.c_str());
+  SetHttpInterceptForTesting([](HttpPostOptions o) {
+    *o.response_code = 401; *o.response = "sensitive-server-error"; return SASL_OK;
+  });
+  assert(ApplicationToken(path, true, true, &token) != SASL_OK);
+  assert(ApplicationToken(path, true, false, &token) == SASL_OK && token == "new-token");
+  TestSaslRejectionRenews(path);
+  chmod(path.c_str(), 0644);
+  assert(ApplicationToken(path, true, false, &token) != SASL_OK);
+  unlink(path.c_str());
+  assert(symlink("/etc/passwd", path.c_str()) == 0);
+  assert(ApplicationToken(path, true, false, &token) != SASL_OK);
+  unlink(path.c_str()); unlink((path + ".lock").c_str()); rmdir(dir);
+}

diff --git a/src/application_token.cc b/src/application_token.cc
new file mode 100644
index 0000000..a6dd88a
--- /dev/null
+++ b/src/application_token.cc
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: Apache-2.0
+// Native Microsoft 365 client credentials; no delegated grants or token logging.
+#include "application_token.h"
+#include "config.h"
+#include "http.h"
+#include <json/json.h>
+#include <sasl/sasl.h>
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <chrono>
+#include <thread>
+#include <ctime>
+#include <regex>
+#include <memory>
+
+namespace sasl_xoauth2 {
+namespace {
+struct FD {
+  int value;
+  explicit FD(int v) : value(v) {}
+  ~FD() { if (value >= 0) close(value); }
+};
+bool Protected(int fd, bool directory = false) {
+  struct stat st;
+  return fd >= 0 && fstat(fd, &st) == 0 && st.st_uid == geteuid() &&
+    (directory ? S_ISDIR(st.st_mode) : S_ISREG(st.st_mode)) &&
+    (st.st_mode & 0077) == 0 && (directory || st.st_nlink == 1);
+}
+bool Parse(const std::string &text, Json::Value *root) {
+  Json::CharReaderBuilder b;
+  b["rejectDupKeys"] = true;
+  b["failIfExtra"] = true;
+  std::unique_ptr<Json::CharReader> r(b.newCharReader());
+  std::string errors;
+  return r->parse(text.data(), text.data() + text.size(), root, &errors) && root->isObject();
+}
+bool Read(int dir, const std::string &name, Json::Value *root) {
+  FD fd(openat(dir, name.c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+  if (!Protected(fd.value)) return false;
+  std::string text;
+  char buf[4096];
+  ssize_t n;
+  while ((n = read(fd.value, buf, sizeof(buf))) > 0) {
+    text.append(buf, n);
+    if (text.size() > 262144) return false;
+  }
+  return n == 0 && Parse(text, root);
+}
+std::string Encode(const std::string &s) {
+  const char *hex = "0123456789ABCDEF";
+  std::string out;
+  for (unsigned char c : s) {
+    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+        (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~') out += c;
+    else { out += '%'; out += hex[c >> 4]; out += hex[c & 15]; }
+  }
+  return out;
+}
+bool Token(const Json::Value &v) {
+  if (!v.isString()) return false;
+  const auto s = v.asString();
+  if (s.empty() || s.size() > 65536) return false;
+  for (unsigned char c : s) if (c <= 32 || c >= 127) return false;
+  return true;
+}
+bool Save(int dir, const std::string &name, const Json::Value &root) {
+  // One stable lock serializes this fixed temporary name. Exclusive creation
+  // fails closed on stale/symlinked files; never follows an attacker path.
+  const std::string temp = name + ".new";
+  FD fd(openat(dir, temp.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
+  if (fd.value < 0) return false;
+  Json::StreamWriterBuilder b;
+  const std::string data = Json::writeString(b, root);
+  size_t done = 0;
+  bool ok = true;
+  while (done < data.size()) {
+    const ssize_t n = write(fd.value, data.data() + done, data.size() - done);
+    if (n <= 0) { ok = false; break; }
+    done += n;
+  }
+  ok = ok && fsync(fd.value) == 0;
+  if (ok) ok = renameat(dir, temp.c_str(), dir, name.c_str()) == 0;
+  if (!ok) unlinkat(dir, temp.c_str(), 0);
+  return ok && fsync(dir) == 0;
+}
+}
+int ApplicationToken(const std::string &path, bool updates, bool force, std::string *token) {
+  // All errors are deliberately generic: JSON/curl exceptions can contain secrets.
+  try {
+    const auto *c = Config::Get();
+    const std::regex endpoint("https://login\\.microsoftonline\\.com/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/oauth2/v2\\.0/token");
+    if (!std::regex_match(c->token_endpoint(), endpoint) || c->client_id().empty() ||
+        c->client_id().size() > 4096 || c->client_secret().empty() || c->client_secret().size() > 8192)
+      return SASL_FAIL;
+    const auto slash = path.find_last_of('/');
+    if (slash == std::string::npos) return SASL_FAIL;
+    const std::string name = path.substr(slash + 1);
+    if (name.empty() || name == "." || name == "..") return SASL_FAIL;
+    FD dir(open(path.substr(0, slash).c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (!Protected(dir.value, true)) return SASL_FAIL;
+    FD lock(openat(dir.value, (name + ".lock").c_str(), O_RDWR | O_CREAT | O_NOFOLLOW | O_CLOEXEC, 0600));
+    if (!Protected(lock.value)) return SASL_FAIL;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(55);
+    while (flock(lock.value, LOCK_EX | LOCK_NB) != 0) {
+      if (errno != EWOULDBLOCK || std::chrono::steady_clock::now() >= deadline) return SASL_TRYAGAIN;
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+    Json::Value cache;
+    if (!Read(dir.value, name, &cache)) return SASL_FAIL;
+    const time_t now = time(nullptr);
+    if (!force && Token(cache["access_token"]) && cache["expiry"].isInt64() &&
+        cache["expiry"].asInt64() > now + 60) {
+      *token = cache["access_token"].asString();
+      return SASL_OK;
+    }
+    const std::string request = "grant_type=client_credentials&client_id=" + Encode(c->client_id()) +
+      "&client_secret=" + Encode(c->client_secret()) + "&scope=" + Encode("https://outlook.office365.com/.default");
+    std::string response, error;
+    long code = 0;
+    const std::string url = c->token_endpoint(), proxy = c->proxy(), ca = c->ca_bundle_file(), capath = c->ca_certs_dir();
+    const int result = HttpPost({url, request, proxy, ca, capath, &code, &response, &error, true});
+    if (result != SASL_OK || code != 200 || response.size() > 262144) return SASL_TRYAGAIN;
+    Json::Value body;
+    if (!Parse(response, &body) || !Token(body["access_token"]) ||
+        !body["token_type"].isString() || (body["token_type"].asString() != "Bearer" && body["token_type"].asString() != "bearer") ||
+        !body["expires_in"].isInt64() || body["expires_in"].asInt64() <= 60 || body["expires_in"].asInt64() > 86400)
+      return SASL_BADPROT;
+    Json::Value fresh;
+    fresh["access_token"] = body["access_token"];
+    // Count lifetime from request start, not response receipt.
+    fresh["expiry"] = Json::Int64(now + body["expires_in"].asInt64());
+    if (fresh["expiry"].asInt64() <= time(nullptr) + 60) return SASL_TRYAGAIN;
+    if (updates && !Save(dir.value, name, fresh)) return SASL_FAIL;
+    *token = fresh["access_token"].asString();
+    return SASL_OK;
+  } catch (...) { return SASL_FAIL; }
+}
+}
